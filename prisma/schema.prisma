generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String            @id @default(cuid())
  email      String            @unique
  name       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  businesses BusinessProfile[]
}

model BusinessProfile {
  id                  String               @id
  userId              String
  businessName        String
  businessType        String
  legalEntityName     String
  yearsInBusiness     Int
  description         String               @db.Text
  address             String
  zipCode             String
  state               String
  annualRevenue       Float
  payroll             Float
  employeeCount       Int
  customerFootTraffic Boolean
  offsiteWork         Boolean
  vehiclesUsed        Boolean
  subcontractorsUsed  Boolean
  storesCustomerData  Boolean
  priorClaims         Json
  renewalDate         DateTime
  profileData         Json?
  claimsFinancialData Json?
  propertyData        Json?
  cyberSafetyData     Json?
  documentationData   Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationRisk        LocationRisk?
  evidence            EvidenceDocument[]
  sourceDocuments     SourceDocument[]
  documentChunks      DocumentChunk[]
  documentFacts       DocumentFact[]
  timeline            TimelineEvent[]
  recommendedActions  RecommendedAction[]
  snapshots           ReadinessSnapshot[]

  @@index([userId, updatedAt])
}

model LocationRisk {
  id                 String          @id @default(cuid())
  businessId         String          @unique
  zipCode            String
  naturalHazardLevel String
  floodRisk          String
  wildfireRisk       String
  severeWeatherRisk  String
  crimeOrTheftRisk   String
  explanation        String          @db.Text

  business           BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model EvidenceDocument {
  id                    String          @id
  businessId            String
  documentType          String
  name                  String
  uploadedAt            DateTime?
  status                String
  extractedFields       Json
  underwritingRelevance String          @db.Text
  confidenceImpact      Int
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  business              BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceDocument        SourceDocument?

  @@index([businessId, status])
}

model SourceDocument {
  id                 String          @id @default(cuid())
  businessId         String
  evidenceDocumentId String?         @unique
  documentType       String
  originalFileName   String
  mimeType           String?
  byteSize           Int?
  storageProvider    String          @default("local")
  storageKey         String?
  checksum           String?
  parseStatus        String          @default("pending")
  semanticStatus     String          @default("pending")
  rawText            String?         @db.Text
  summary            String?         @db.Text
  extractionMetadata Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  business           BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  evidenceDocument   EvidenceDocument? @relation(fields: [evidenceDocumentId], references: [id], onDelete: SetNull)
  chunks             DocumentChunk[]
  extractedFacts     DocumentFact[]

  @@index([businessId, createdAt])
  @@index([parseStatus, semanticStatus])
}

model DocumentChunk {
  id               String          @id @default(cuid())
  businessId       String
  sourceDocumentId String
  chunkIndex       Int
  content          String          @db.Text
  tokenCount       Int             @default(0)
  embedding        Float[]
  semanticMetadata Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  business         BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceDocument   SourceDocument  @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  @@unique([sourceDocumentId, chunkIndex])
  @@index([businessId, createdAt])
}

model DocumentFact {
  id               String          @id @default(cuid())
  businessId       String
  sourceDocumentId String
  label            String
  value            Json
  confidence       Float?
  provenanceChunkIds String[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  business         BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceDocument   SourceDocument  @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  @@index([businessId, label])
  @@index([sourceDocumentId, createdAt])
}

model TimelineEvent {
  id               String           @id
  businessId       String
  date             DateTime
  title            String
  description      String           @db.Text
  scoreImpact      Int
  confidenceImpact Int
  category         String
  createdAt        DateTime         @default(now())

  business         BusinessProfile  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, date])
}

model RecommendedAction {
  id                  String          @id
  businessId          String
  title               String
  description         String          @db.Text
  priority            String
  effort              String
  expectedScoreImpact Int
  status              String
  category            String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  business            BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, priority])
}

model ReadinessSnapshot {
  id                    String          @id @default(cuid())
  businessId            String
  overallScore          Int
  confidenceScore       Int
  dataCompleteness      Int
  classificationClarity Int
  financialStability    Int
  lossHistory           Int
  propertyControls      Int
  operationalControls   Int
  locationContext       Int
  operationalScore      Int?
  claimsFinancialScore  Int?
  propertyLocationScore Int?
  cyberSafetyScore      Int?
  documentationScore    Int?
  explanation           String          @db.Text
  strengths             Json
  concerns              Json
  createdAt             DateTime        @default(now())

  business              BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}
