generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String            @id @default(cuid())
  email      String            @unique
  name       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  businesses BusinessProfile[]
}

model BusinessProfile {
  id                  String               @id
  userId              String
  businessName        String
  businessType        String
  legalEntityName     String
  yearsInBusiness     Int
  description         String
  address             String
  zipCode             String
  state               String
  annualRevenue       Float
  payroll             Float
  employeeCount       Int
  customerFootTraffic Boolean
  offsiteWork         Boolean
  vehiclesUsed        Boolean
  subcontractorsUsed  Boolean
  storesCustomerData  Boolean
  priorClaims         String
  renewalDate         DateTime
  profileData         String?
  claimsFinancialData String?
  propertyData        String?
  cyberSafetyData     String?
  documentationData   String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationRisk        LocationRisk?
  evidence            EvidenceDocument[]
  timeline            TimelineEvent[]
  recommendedActions  RecommendedAction[]
  snapshots           ReadinessSnapshot[]
}

model LocationRisk {
  id                 String          @id @default(cuid())
  businessId         String          @unique
  zipCode            String
  naturalHazardLevel String
  floodRisk          String
  wildfireRisk       String
  severeWeatherRisk  String
  crimeOrTheftRisk   String
  explanation        String

  business           BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model EvidenceDocument {
  id                    String          @id
  businessId            String
  documentType          String
  name                  String
  uploadedAt            DateTime?
  status                String
  extractedFields       String
  underwritingRelevance String
  confidenceImpact      Int
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  business              BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model TimelineEvent {
  id               String           @id
  businessId       String
  date             DateTime
  title            String
  description      String
  scoreImpact      Int
  confidenceImpact Int
  category         String
  createdAt        DateTime         @default(now())

  business         BusinessProfile  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, date])
}

model RecommendedAction {
  id                  String          @id
  businessId          String
  title               String
  description         String
  priority            String
  effort              String
  expectedScoreImpact Int
  status              String
  category            String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  business            BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model ReadinessSnapshot {
  id                    String          @id @default(cuid())
  businessId            String
  overallScore          Int
  confidenceScore       Int
  dataCompleteness      Int
  classificationClarity Int
  financialStability    Int
  lossHistory           Int
  propertyControls      Int
  operationalControls   Int
  locationContext       Int
  operationalScore      Int?
  claimsFinancialScore  Int?
  propertyLocationScore Int?
  cyberSafetyScore      Int?
  documentationScore    Int?
  explanation           String
  strengths             String
  concerns              String
  createdAt             DateTime        @default(now())

  business              BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}
