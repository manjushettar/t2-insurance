generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String               @id @default(cuid())
  email      String               @unique
  name       String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  businesses BusinessProfile[]
}

model BusinessProfile {
  id                  String               @id
  userId              String
  businessName        String
  businessType        String
  legalEntityName     String
  description         String               @db.Text
  address             String
  zipCode             String
  state               String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  underwritingProfiles UnderwritingProfile[]
  evidence            EvidenceDocument[]
  sourceDocuments     SourceDocument[]
  documentChunks      DocumentChunk[]
  documentFacts       DocumentFact[]
  timeline            TimelineEvent[]
  scoreRuns           ScoreRun[]

  @@index([userId, updatedAt])
}

model UnderwritingProfile {
  id                String          @id @default(cuid())
  businessId        String
  version           Int             @default(1)
  rawFeatures       Json
  zipAreaFeatures   Json?
  acordFlags        Json?
  synthetic         Boolean         @default(true)
  completenessHint  Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  business          BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scoreRuns         ScoreRun[]

  @@index([businessId, createdAt])
  @@unique([businessId, version])
}

model EvidenceDocument {
  id                    String          @id
  businessId            String
  documentType          String
  name                  String
  uploadedAt            DateTime?
  status                String
  extractedFields       Json
  underwritingRelevance String          @db.Text
  confidenceImpact      Int
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  business              BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceDocument        SourceDocument?

  @@index([businessId, status])
}

model SourceDocument {
  id                 String          @id @default(cuid())
  businessId         String
  evidenceDocumentId String?         @unique
  documentType       String
  originalFileName   String
  mimeType           String?
  byteSize           Int?
  storageProvider    String          @default("local")
  storageKey         String?
  checksum           String?
  parseStatus        String          @default("pending")
  semanticStatus     String          @default("pending")
  rawText            String?         @db.Text
  summary            String?         @db.Text
  extractionMetadata Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  business           BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  evidenceDocument   EvidenceDocument? @relation(fields: [evidenceDocumentId], references: [id], onDelete: SetNull)
  chunks             DocumentChunk[]
  extractedFacts     DocumentFact[]

  @@index([businessId, createdAt])
  @@index([parseStatus, semanticStatus])
}

model DocumentChunk {
  id                String          @id @default(cuid())
  businessId        String
  sourceDocumentId  String
  chunkIndex        Int
  content           String          @db.Text
  tokenCount        Int             @default(0)
  embedding         Float[]
  semanticMetadata  Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  business          BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceDocument    SourceDocument  @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  @@unique([sourceDocumentId, chunkIndex])
  @@index([businessId, createdAt])
}

model DocumentFact {
  id                 String          @id @default(cuid())
  businessId         String
  sourceDocumentId   String
  label              String
  value              Json
  confidence         Float?
  provenanceChunkIds String[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  business           BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceDocument     SourceDocument  @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  @@index([businessId, label])
  @@index([sourceDocumentId, createdAt])
}

model ScoreRun {
  id                  String               @id @default(cuid())
  businessId          String
  underwritingProfileId String
  engineVersion       String               @default("synthetic-v1")
  compositeScore      Int
  rawWeightedScore    Float
  pillars             Json
  contributionTable   Json
  knockouts           Json
  recommendations     Json
  completeness        Json
  synthetic           Boolean              @default(true)
  createdAt           DateTime             @default(now())

  business            BusinessProfile      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  underwritingProfile UnderwritingProfile  @relation(fields: [underwritingProfileId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([underwritingProfileId, createdAt])
}

model TimelineEvent {
  id               String           @id
  businessId       String
  date             DateTime
  title            String
  description      String           @db.Text
  scoreImpact      Int
  confidenceImpact Int
  category         String
  createdAt        DateTime         @default(now())

  business         BusinessProfile  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, date])
}
